// Pipeline de Jenkins de la integración AS → ANPR: una etapa por circuito (tests/integracion/as-anpr).
// Cada integración entre productos tiene su propio Jenkinsfile.integracion-<productos> y su job.
// Es aparte del Jenkinsfile de productos porque instala AS, crea datos en ANPR y tarda más.
// Usa la VM de AS: no correr a la vez que la etapa AS del otro pipeline ni otra integración con AS
// (si coinciden, el test se frena con "AS ya está instalado").

// Corre un archivo de tests de tests/integracion/as-anpr con su reporte HTML en playwright-report/<archivo>.
// Si falla, la etapa queda en rojo pero el pipeline sigue con las demás etapas.
def integracion(String archivo) {
  catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
    withCredentials([
      usernamePassword(credentialsId: 'anpr', usernameVariable: 'APP_USER', passwordVariable: 'APP_PASSWORD'),
      usernamePassword(credentialsId: 'as', usernameVariable: 'AS_USER', passwordVariable: 'AS_PASSWORD'),
    ]) {
      withEnv([
        "PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report/${archivo}",
        "PLAYWRIGHT_JUNIT_OUTPUT_FILE=playwright-report/junit/${archivo}.xml",
      ]) {
        // Sin reintentos: cada intento vuelve a instalar AS y a crear datos en ANPR
        bat "npx playwright test --project=integracion as-anpr/${archivo} --retries=0 --reporter=list,html,junit ${params.VER_NAVEGADOR ? '--headed' : ''}"
      }
    }
  }
}

pipeline {
  agent any

  parameters {
    booleanParam(name: 'LISTA', defaultValue: true, description: 'Las patentes detectadas llegan al widget Lista y se ve su detalle')
    booleanParam(name: 'ALARMAS', defaultValue: true, description: 'Patentes en una lista con alarma generan alarmas que se atienden y quedan en Auditoría')
    booleanParam(name: 'VER_NAVEGADOR', defaultValue: false, description: 'Abrir el navegador en pantalla (para una demo): ANPR a la izquierda y el video de AS a la derecha')
  }

  options {
    disableConcurrentBuilds()
  }

  environment {
    CI = 'true'
    CYPRESS_INSTALL_BINARY = '0' // el pipeline no corre Cypress
    PLAYWRIGHT_HTML_OPEN = 'never'
    BASE_URL = 'https://nginx-central-anpr.testing.docker.dev-dnd.com/www/'
    AS_HOST = '10.150.2.165'
    AS_DIR = '/home/testing/server2.4'
  }

  stages {
    stage('Instalar dependencias') {
      steps {
        dir('playwright-report') { deleteDir() }
        bat 'npm ci'
      }
    }
    stage('AS → ANPR: Lista y detalle') {
      when { expression { params.LISTA } }
      steps { integracion('lista') }
    }
    stage('AS → ANPR: Alarmas') {
      when { expression { params.ALARMAS } }
      steps { integracion('alarmas') }
    }
  }

  post {
    always {
      junit allowEmptyResults: true, testResults: 'playwright-report/junit/*.xml'
      script {
        def reportes = ['lista': 'AS → ANPR Lista', 'alarmas': 'AS → ANPR Alarmas']
        reportes.each { archivo, nombre ->
          if (fileExists("playwright-report/${archivo}/index.html")) {
            publishHTML(target: [
              reportName: "Reporte ${nombre}",
              reportDir: "playwright-report/${archivo}",
              reportFiles: 'index.html',
              keepAll: true,
              alwaysLinkToLastBuild: true,
              allowMissing: true,
            ])
          }
        }
      }
    }
  }
}
